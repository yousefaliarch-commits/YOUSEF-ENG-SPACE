<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">
        <!-- push notifications (Firebase Cloud Messaging): the status-bar icon, its tint and the fallback channel -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_engspace" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/push_accent" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="system" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- auth links (confirm e-mail, reset password): app.engspace://auth-callback; shared posts and jobs: app.engspace://open/<type>/<id> -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.engspace" android:host="auth-callback" />
                <data android:scheme="app.engspace" android:host="open" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asking to show notifications is a runtime permission (the primer sheet asks first) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- «التقاط صورة» (posts, profile photo, QA/QC inspection photos, verification): asked at the moment the camera is
         chosen, never at launch (src/native/camera.ts checks and requests it before the camera opens; the web view's own
         capture path asks the same way). With CAMERA declared, the camera must never open before it is granted. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- a tablet or phone without a camera can still install the app: photos then come from the gallery -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+ hides other apps unless we say what we look for: without this the camera app is "not found" and
         «التقاط صورة» silently falls back to the file picker (the camera plugin's manifest adds the same entries) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>
</manifest>
