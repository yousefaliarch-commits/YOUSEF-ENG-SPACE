{
  "name": "engspace",
  "private": true,
  "version": "0.25.0",
  "description": "EngSpace — the anonymous career and salary network for Egyptian engineers (web app, packaged for iOS and Android with Capacitor).",
  "type": "module",
  "scripts": {
    "i18n": "node scripts/i18n/extract.mjs && node scripts/i18n/build.mjs",
    "predev": "node scripts/copy-vendor.mjs && npm run i18n",
    "dev": "vite",
    "prebuild": "node scripts/copy-vendor.mjs && npm run i18n",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "pretest": "npm run i18n",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "phone": "node scripts/phone-server.mjs --lan",
    "live": "node scripts/live.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:env": "node scripts/db/env-local.mjs",
    "db:admin": "node scripts/db/make-admin.mjs",
    "test:cloud": "node scripts/db/test-cloud.mjs",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "0.468.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "3.11.174",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "supabase": "^2.119.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
