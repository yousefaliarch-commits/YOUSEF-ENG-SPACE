{
  "name": "engspace",
  "private": true,
  "version": "0.27.0",
  "description": "EngSpace — the anonymous career and salary network for Egyptian engineers (web app, packaged for iOS and Android with Capacitor).",
  "type": "module",
  "scripts": {
    "i18n": "node scripts/i18n/extract.mjs && node scripts/i18n/build.mjs",
    "predev": "node scripts/copy-vendor.mjs && npm run i18n",
    "dev": "vite",
    "prebuild": "node scripts/copy-vendor.mjs && npm run i18n",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "pretest": "npm run i18n",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "phone": "node scripts/phone-server.mjs --lan",
    "live": "node scripts/live.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:env": "node scripts/db/env-local.mjs",
    "db:admin": "node scripts/db/make-admin.mjs",
    "test:cloud": "node scripts/db/test-cloud.mjs",
    "cap:sync": "npm run build && cap sync",
    "db:seed": "node scripts/seed/local.mjs",
    "db:functions": "supabase functions serve --env-file supabase/functions/local.env",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:demo": "playwright test -c e2e/playwright.config.ts demo.spec.ts",
    "e2e:live": "playwright test -c e2e/playwright.config.ts live.spec.ts"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-updater": "8.52.1",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "3.11.174",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@capacitor/android": "8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "6.2.5",
    "postcss": "^8.5.28",
    "sharp": "0.32.6",
    "supabase": "^2.119.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
