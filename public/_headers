# Cloudflare Pages response headers (ignored by the phone apps and the local servers).
# Hashed build files never change — cache them for a year; the page itself is always revalidated so a deploy shows at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
