{"nodes": [{"id": "docs_phase2", "label": "PHASE2.md \u2014 Supabase (Frankfurt) and Capacitor 8", "file_type": "document", "source_file": "docs/PHASE2.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase2_phase_2", "label": "Phase 2: Supabase backend + Capacitor 8 native shells", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L1-L4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real backend and native shells without changing what the app does."}, {"id": "docs_phase2_backend_modes", "label": "Run modes: Demo / Cloud / Native", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L3-L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Demo (no VITE_SUPABASE_* or ?backend=demo) is exactly Phase 1 with seed data; Cloud uses the Supabase project with RLS; Native is the same build inside the iOS / Android apps."}, {"id": "docs_phase2_supabase_project", "label": "Supabase project (Central EU Frankfurt, eu-central-1)", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L54-L62; L90", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase2_capacitor_shells", "label": "Capacitor 8 iOS / Android shells", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L20; L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase2_backend_layer", "label": "Client backend layer (config \u00b7 client \u00b7 map \u00b7 cloud)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L14-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Supabase client is its own lazy chunk and keeps the session in Capacitor Preferences on phones; map.ts is pure (server rows \u21c4 app shapes); cloud.ts holds every call the app and the console make."}, {"id": "docs_phase2_optimistic_sync", "label": "Optimistic updates + sync(() => cloud.\u2026) + loadAll() hydrate", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L27-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each handler updates the screen at once and sends the same change to the server; loadAll() replaces local state after sign-in, on pull-to-refresh and on return to the foreground; an open conversation checks for new messages every 5 s."}, {"id": "docs_phase2_privacy_model", "label": "Privacy model enforced by the database", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L31-L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every rule is checked as real members (JWT claims) in pgTAP and again through cloud.ts and the Storage API."}, {"id": "docs_phase2_author_snapshot", "label": "Server-built author snapshot (private.author_snapshot)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L33-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clients cannot write it, so nobody can claim a badge, a role or another member's name."}, {"id": "docs_phase2_private_authorship", "label": "private.authorship \u2014 who wrote what, unreadable by any client role", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase2_anonymous_snapshot", "label": "Anonymous snapshot (handle, role, years, credential only)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L36-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No name, age, city, employer or graduation year; the app renders the title from these fields."}, {"id": "docs_phase2_private_threads", "label": "Private threads via functions (start_thread, my_threads, send_message)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L38-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Threads and messages live in the private schema; neither side ever receives the other's account id."}, {"id": "docs_phase2_salary_bands", "label": "salary_bands \u2014 aggregate pay bands for HR / owners", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L40-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cell needs \u2265 5 reports."}, {"id": "docs_phase2_moderation_by_reference", "label": "Moderation by reference (mod_ref acc-xxxxxx, anonymous reports)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L42-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staff never see the name or e-mail behind an anonymous item; distinct reporters reaching the threshold hide an item; a dismissed case doubles its threshold."}, {"id": "docs_phase2_verification_document_expiry", "label": "Verification documents expire (private bucket, own folder, 7 days max)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L44-L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A decision or withdrawal returns the paths and the app deletes them at once; an unreviewed request expires after 7 days (pg_cron, hourly) and purge-verification sweeps anything left."}, {"id": "docs_phase2_account_deletion", "label": "Account deletion deletes everything it wrote", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Content first, then the account; profile, threads, reactions and requests cascade."}, {"id": "docs_phase2_signed_out_lockdown", "label": "Signed-out lockdown (20261002000006_lockdown.sql)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L48-L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed-out visitors reach nothing; every function the app calls is granted to authenticated explicitly."}, {"id": "docs_phase2_pgtap_suites", "label": "pgTAP privacy and permission suites (supabase/tests)", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L22; L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "89 checks at Phase 2, run as real members through JWT claims."}, {"id": "docs_phase2_purge_verification_cron", "label": "Hourly purge-verification sweep (pg_cron + pg_net, PURGE_SECRET)", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L68-L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scheduled as engspace-purge-verification at minute 17 of every hour; the function is called with the x-purge-secret header."}, {"id": "docs_phase2_publishable_key_rule", "label": "Publishable key in the app, service-role key never", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L77-L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The publishable key is designed to ship inside apps (also a GitHub secret for CI builds); the service-role / secret key must never be put in the app or the repository."}, {"id": "docs_phase2_bootstrap_admin", "label": "bootstrap_admin() \u2014 first administrator", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L81-L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works only while there is no administrator; further moderators and admins are granted from the console."}, {"id": "docs_phase2_sign_in_methods", "label": "Sign-in methods (e-mail, Google, Apple, phone SMS)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L85-L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app shows a button for each method only once it is switched on in the project, so nothing breaks before setup; Apple sign-in is required on iOS when Google is offered; each SMS is billed by the provider."}, {"id": "docs_phase2_auth_email_templates", "label": "Supabase auth e-mail templates (Confirm signup, Reset password)", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L99-L101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Their links work on any device and carry the 6-digit code."}, {"id": "docs_phase2_cross_device_confirmation", "label": "Cross-device e-mail confirmation (\u00ab\u0623\u0643\u0651\u062f \u0628\u0631\u064a\u062f\u0643\u00bb)", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L103-L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After sign-up the app waits and signs in by itself as soon as the link is opened on any device (quiet retry every 10 s and on return to the front), or with the code; Site URL must point at the hosted web app."}, {"id": "docs_phase2_profile_completion", "label": "Complete-your-profile onboarding (\u00ab\u0623\u0643\u0645\u0644 \u0645\u0644\u0641\u0643\u00bb)", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accounts made with Google, Apple or a phone number go through the profile steps once."}, {"id": "docs_phase2_local_dev", "label": "Local Supabase development (Docker, Mailpit, db:* scripts)", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L109-L121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unit tests never read .env.local (vitest.config.ts \u2192 envDir); deleting .env.local returns to the demo."}, {"id": "docs_phase2_live_preview", "label": "Laptop + phone live preview (npm run live, port 8770)", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L123-L142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuilds on every save and reloads both pages about two seconds later; --android installs a live-reload app over USB, --tunnel prints a localhost.run address, and every push builds an installable debug APK artifact."}, {"id": "docs_phase2_performance_120hz", "label": "120 Hz performance rules", "file_type": "rationale", "source_file": "docs/PHASE2.md", "source_location": "L144-L154", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured at 6\u00d7 CPU slowdown: median frame 52 ms \u2192 2\u20133 ms, p95 79 \u2192 7\u20139 ms. SVG animation repaints every frame (idle character life only from 64 px, paused while scrolling); no backdrop-filter over scrolling content; animate transform / opacity only; gestures write styles directly; long lists windowed."}, {"id": "docs_phase2_follow_ups", "label": "Phase 2 follow-ups (realtime, push, media sweep, pagination, iOS CI, admin web app)", "file_type": "concept", "source_file": "docs/PHASE2.md", "source_location": "L156-L163", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_phase2", "target": "docs_phase2_phase_2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/PHASE2.md", "source_location": "L1-L4", "weight": 1.0}, {"source": "docs_phase2", "target": "docs_phase2_backend_modes", "relation