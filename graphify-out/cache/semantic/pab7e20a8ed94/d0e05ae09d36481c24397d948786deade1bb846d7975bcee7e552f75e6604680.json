{"nodes": [{"id": "docs_push", "label": "PUSH.md \u2014 push notifications", "file_type": "document", "source_file": "docs/PUSH.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_push_push_pipeline", "label": "Push notification pipeline (SQL trigger \u2192 outbox \u2192 send-push \u2192 FCM / APNs)", "file_type": "rationale", "source_file": "docs/PUSH.md", "source_location": "L7-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lock-screen text for replies, mentions and messages is generic \u2014 never the text or the sender; a tap opens the job / post / chat / ticket validated by openTarget()."}, {"id": "docs_push_notifications_table", "label": "public.notifications \u2014 in-app notification center (realtime)", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every notice appears here, with category and English text, even before phone delivery is configured."}, {"id": "docs_push_notifications_push_trigger", "label": "notifications_push trigger (switch on + device registered)", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_push_push_outbox", "label": "private.push_outbox \u2014 push delivery queue", "file_type": "rationale", "source_file": "docs/PUSH.md", "source_location": "L12; L72-L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows older than 24 h are dropped unsent (a late push is worse than none); everything is deleted after 7 days."}, {"id": "docs_push_kick_push", "label": "private.kick_push() + engspace-push-sweep cron", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L14; L46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_net wakes send-push once per transaction; pg_cron sweeps every minute."}, {"id": "docs_push_user_push_tokens", "label": "user_push_tokens \u2014 device tokens, never client-readable", "file_type": "rationale", "source_file": "docs/PUSH.md", "source_location": "L69; L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dead token is deleted on the first failed send; at most 8 devices per member; sign-out drops the device; a platform = 'web' slot is reserved."}, {"id": "docs_push_notification_prefs", "label": "Notification preferences (notification_prefs + profiles.settings.notify)", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L31-L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switches: master, jobs, replies, messages, salary, support; account and moderation notices (verify, mod, warn, suspend, report) have no switch."}, {"id": "docs_push_job_match_alerts", "label": "New-job match alerts", "file_type": "rationale", "source_file": "docs/PUSH.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engineers of the job's discipline (and track), experience within a year of the range, in the job's governorate (remote: anywhere); \u2264 3 job alerts a day and \u2264 1000 members per job."}, {"id": "docs_push_reply_mention_notices", "label": "Reply / @mention notices", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never yourself; a burst is one notice per 10 minutes."}, {"id": "docs_push_message_notices", "label": "Private message notices", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One notice per thread while unread; never the text."}, {"id": "docs_push_ticket_notices", "label": "Support ticket notices (reply and status change)", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_push_inflation_month_notice", "label": "Inflation month notice", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "To engineers with \u00absalary\u00bb on, when staff add the month."}, {"id": "docs_push_salary_cell_notice", "label": "Salary cell reaches 5 reports notice", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "To engineers who shared in that discipline + governorate (\u00b12 years); once."}, {"id": "docs_push_fcm", "label": "Firebase Cloud Messaging (FCM, Android)", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L15; L49-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_push_apns", "label": "Apple Push Notification service (APNs, iOS)", "file_type": "concept", "source_file": "docs/PUSH.md", "source_location": "L15; L59-L65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Firebase iOS SDK: the app registers the raw APNs token and the function talks to APNs directly."}, {"id": "docs_push_fcm_setup", "label": "Android FCM setup (FCM_SERVICE_ACCOUNT \u2192 Deploy database)", "file_type": "rationale", "source_file": "docs/PUSH.md", "source_location": "L49-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "google-services.json is committed because it holds only the public app config; the service-account JSON is never committed (