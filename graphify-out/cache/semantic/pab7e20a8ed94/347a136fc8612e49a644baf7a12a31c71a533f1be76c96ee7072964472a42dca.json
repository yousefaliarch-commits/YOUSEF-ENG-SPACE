{"nodes": [{"id": "docs_security", "label": "SECURITY.md \u2014 security and media rules", "file_type": "document", "source_file": "docs/SECURITY.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_transformation_plan_phase_1", "label": "Transformation plan Phase 1 (security steps 1.1\u20131.5)", "file_type": "concept", "source_file": "docs/SECURITY.md", "source_location": "L3-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1.2 database armor and 1.3 media privacy are in place, pinned by pgTAP, unit, cloud and e2e tests; 1.1, 1.4 and 1.5 follow."}, {"id": "docs_security_default_deny", "label": "Default deny (migration 24)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L7-L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No function is callable by PUBLIC / anon and none by authenticated without an explicit grant; the Postgres default EXECUTE to PUBLIC is revoked; authenticated never holds TRUNCATE / TRIGGER / REFERENCES (none is covered by RLS); every public table has RLS and every security-definer function pins search_path."}, {"id": "docs_security_rate_limits", "label": "Write rate limits (private.limit_writes, SQLSTATE 54000)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L16-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-bucket burst / window / daily limits on posts, comments, messages, reviews, jobs, tickets and reports; staff and the service role are exempt; a SQL session may switch them off for tests, the Data API cannot."}, {"id": "docs_security_role_guard", "label": "Role-change guard (private.role_guard: once in 30 days)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L20-L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free while completing the profile, then once in 30 days with verification dropped, audited by mod_ref; onboarding cannot be reopened."}, {"id": "docs_security_job_view_counting", "label": "Job views count once per member per job per day", "file_type": "concept", "source_file": "docs/SECURITY.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed-in members only."}, {"id": "docs_security_jsonb_caps", "label": "jsonb size caps (posts.data 16 KB, member_state 1 MB, 40 keys)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L24-L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only reveal, image, vote and poll survive in posts.data; comments / reviews data and profiles.settings are capped at 4 KB."}, {"id": "docs_security_upload_media_pipeline", "label": "Image upload pipeline (compress.ts \u2192 upload-media Edge Function)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L27-L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The function re-reads the real format and size from the bytes, refuses PNG / SVG / animated / oversized images, strips EXIF / XMP / comments again and stores with the service role \u2014 members never write to Storage directly."}, {"id": "docs_security_media_register", "label": "media_register() upload quotas", "file_type": "concept", "source_file": "docs/SECURITY.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "30 / 10 min \u00b7 300 / day \u00b7 10 avatars / day \u00b7 100 MB per member."}, {"id": "docs_security_storage_buckets", "label": "Storage buckets by media kind (media, support, verification, inspections)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L35-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public files get random names (p/, a/); private files stay in the member's own folder and are read through signed URLs."}, {"id": "docs_security_post_images", "label": "post_images + post_media() \u2014 no account id in anything readable", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L43-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "posts.data keeps only geometry, colour and alt text; the path lives in public.post_images (no member policy) and post_media(ids) hands it only to those allowed to see the image."}, {"id": "docs_security_payslip_rule", "label": "Payslip rule \u2014 staff review before HR / owner / supervisor see post images", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L46-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strict default on the server: engineers, the author and staff see an image at once; others only after staff_review_image marks it clean (audited); the phone's client_scan is a hint for staff, never a decision."}, {"id": "docs_security_photo_guard", "label": "private.photo_guard \u2014 profile photo must be the member's own avatar upload", "file_type": "concept", "source_file": "docs/SECURITY.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_media_janitor", "label": "Media janitor (pg_cron engspace-media-janitor every 10 min)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L50-L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves pre-1.3 files to random names and deletes unused uploads (24 h), images of deleted posts and every upload of a deleted account; MEDIA_SECRET is regenerated by the Deploy database workflow and written to the function and Vault."}, {"id": "docs_security_media_removable", "label": "Inspection photo removal (x-media-action: remove, media_removable)", "file_type": "concept", "source_file": "docs/SECURITY.md", "source_location": "L53-L54", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_camera_flow", "label": "Native photo flow (chooser \u2192 camera.ts permission check \u2192 compress \u2192 upload-media)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L56-L69; L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v0.26.0 crashed because iOS ends an app that asks for the camera without NSCameraUsageDescription and an Android web view process death took the whole app; now permission is checked / requested before getPhoto, the plugin scales to \u2264 1600 px, and any plugin failure falls back to the plain input (capture=environment)."}, {"id": "docs_security_native_camera_permissions", "label": "Native camera permissions (Info.plist privacy texts, Android CAMERA + <queries>)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L70-L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With CAMERA declared nothing may start the camera before it is granted; Android 11+ hides the camera app without <queries> for IMAGE_CAPTURE; FileProvider paths cover external files and the cache."}, {"id": "docs_security_render_process_gone_handler", "label": "Renderer-loss handler (MainActivity.onRenderProcessGone \u2192 recreate())", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L74-L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dead web view is removed and destroyed and the screen rebuilt; three losses within a minute end quietly instead of looping; iOS reloads the web view itself."}, {"id": "docs_security_compress_memory", "label": "Memory-safe decode in compress.ts (header read + createImageBitmap resize)", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L76-L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Releases the decoded source before the encode loop, so a 50 MP photo no longer sits in the page process at full size."}, {"id": "docs_security_camera_getphoto_rule", "label": "Camera.getPhoto only inside src/native/camera.ts", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L80-L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_edge_function_shared_logic", "label": "Edge Functions: plain fetch + testable _shared logic modules", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L84-L86", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain fetch against the REST endpoints means no npm download at cold start; logic lives in _shared/*.ts so Vitest drives it with a fake client."}, {"id": "docs_security_open_steps", "label": "Open Phase 1 steps (1.1 guards, 1.4 auth / staff MFA, 1.5 release build)", "file_type": "concept", "source_file": "docs/SECURITY.md", "source_location": "L88-L92", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1.1 branch protection, CODEOWNERS, gitleaks, CodeQL, Dependabot, pinned actions; 1.4 Turnstile, password policy, staff MFA with aal2 in is_staff() / is_admin(); 1.5 private release keystore, R8, Keystore / Keychain sessions, CSP, signed live-update manifest (new native line)."}, {"id": "docs_security_server_side_money_redaction", "label": "Next privacy step: server-side redaction of money in posts", "file_type": "rationale", "source_file": "docs/SECURITY.md", "source_location": "L93-L94", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Salary figures in reveal posts and money amounts in post / comment text are still hidden by the app, not the server; a per-viewer feed RPC would give them the same treatment as images."}], "edges": [{"source": "docs_security", "target": "docs_security_transformation_plan_phase_1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SECURITY.md", "source_location": "L3-L5", "weight": 1.0}, {"source": "docs_security", "target": "docs_security_default_deny", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SECURITY.md", "source_location": "L7-L13", "weight": 1.0}, {"source": "docs_security", "target": "docs_security_rate_limits", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SECURITY.md", "source_location": "L16-L19", "weight": 1.0}, {"source": "docs_security", "target": "docs_security_role_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SECURITY.md", "source_location": "L20-L22", "weight": 1.0}, {"source": "docs_security", "target": "docs_security_job_view_counting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SECURITY.md", "source_location": "L23", "weight": 1.0}, {"source": "docs_security", "target": "docs_security_jsonb_caps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SECURITY.md", "source_location": "L24-L25", "weight": 1.0}, {"source": "docs_security", "target": "docs_security_upload_media_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/SECURITY.md", "source_location": "L27-L34", "weight": 1.0}, {"source": "docs_security", "target": "docs_security_media_register", "relation": "references", "confidence": "EXTRACTED", "confidence_scor