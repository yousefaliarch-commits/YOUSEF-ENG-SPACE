{
  // Build config, tests and scripts: run by Node, so they see Node's types as well as Vite's.
  "extends": "./tsconfig.json",
  // allowImportingTsExtensions: the Edge Functions' shared code is Deno-style (imports end in .ts) and is tested here too
  "compilerOptions": { "types": ["vite/client", "node"], "allowImportingTsExtensions": true },
  "include": ["tests", "e2e", "vite.config.ts", "vitest.config.ts", "src/types/global.d.ts"]
}
